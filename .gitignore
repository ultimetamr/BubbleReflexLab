*.hprof

# Keep only curated validation evidence in Git; exclude intermediate captures
# and extracted diagnostic packages.
artifacts/*
!artifacts/acceptance-report.md
!artifacts/bubble-start-final.png
!artifacts/bubble-feedback-v4.png
!artifacts/screenshots/
artifacts/screenshots/*
!artifacts/screenshots/emulator-tutorial-latest.png
!artifacts/screenshots/emulator-gameplay-latest.png
